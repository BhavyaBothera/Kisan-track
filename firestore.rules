rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /farmers/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
    match /{collection}/{documentId} {
      allow read, delete: if request.auth != null && resource.data.farmerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.farmerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.farmerId == request.auth.uid
        && request.resource.data.farmerId == request.auth.uid;
    }
  }
}
