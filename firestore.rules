rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsNew() { return signedIn() && request.resource.data.farmerId == request.auth.uid; }
    function ownsExisting() { return signedIn() && resource.data.farmerId == request.auth.uid; }
    function ownerUnchanged() { return request.resource.data.farmerId == resource.data.farmerId; }

    match /farmers/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
    match /animals/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew() && request.resource.data.animalId is string && request.resource.data.species is string;
      allow update: if ownsExisting() && ownerUnchanged();
    }
    match /animalLatestVitals/{id} {
      allow read: if ownsExisting();
      allow write: if false;
    }
    match /farmerStats/{id} {
      allow read: if signedIn() && request.auth.uid == id;
      allow write: if false;
    }
    match /vitals/{id} {
      allow read: if ownsExisting();
      allow create: if ownsNew()
        && request.resource.data.animalId is string
        && (!('bodyTempCelsius' in request.resource.data) || request.resource.data.bodyTempCelsius is number)
        && (!('heartRateBpm' in request.resource.data) || request.resource.data.heartRateBpm is number)
        && (!('activityScore' in request.resource.data) || request.resource.data.activityScore is number);
      allow update, delete: if false;
    }
    match /alerts/{id} {
      allow read: if ownsExisting();
      allow create: if ownsNew() && (!('source' in request.resource.data) || request.resource.data.source != 'Nexus AI');
      allow update: if ownsExisting() && ownerUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved','resolvedAt']);
      allow delete: if false;
    }
    match /cameraCaptures/{id} {
      allow read: if ownsExisting();
      allow create, update, delete: if false;
    }
    match /inventory/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew();
      allow update: if ownsExisting() && ownerUnchanged();
    }
    match /inventoryActivity/{id} {
      allow read: if ownsExisting();
      allow create: if ownsNew();
      allow update, delete: if false;
    }
    match /clientTelemetry/{id} {
      allow create: if signedIn()
        && request.resource.data.farmerId == request.auth.uid
        && request.resource.data.eventType is string
        && request.resource.data.eventType.size() <= 80
        && request.resource.data.severity is string
        && request.resource.data.severity in ['error', 'warning', 'info']
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500;
      allow read, update, delete: if false;
    }
    match /systemMetrics/{id} {
      allow read, write: if false;
    }
    match /vet_logs/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew()
        && request.resource.data.animalId is string
        && request.resource.data.type is string;
      allow update: if ownsExisting() && ownerUnchanged();
    }
    match /userPreferences/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.farmerId == userId;
      allow delete: if false;
    }
    match /devices/{id} {
      allow read: if ownsExisting();
      allow create: if ownsNew()
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 80
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 300;
      allow update: if ownsExisting() && ownerUnchanged();
      allow delete: if false;
    }
    match /auditLogs/{id} {
      allow read: if ownsExisting();
      allow create: if ownsNew()
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 80;
      allow update, delete: if false;
    }
    match /dataRequests/{id} {
      allow read: if ownsExisting();
      allow create: if ownsNew()
        && request.resource.data.type in ['export', 'deletion'];
      allow update, delete: if false;
    }
  }
}